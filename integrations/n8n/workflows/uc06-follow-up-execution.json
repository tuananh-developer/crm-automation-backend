    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst recipient = body.recipient || body.to || 'khachhang@example.com';\nconst subject = body.subject || body.emailSubject || 'Thông báo từ hệ thống CRM';\nconst rawMessage = body.message || body.emailBody || body.content || 'Cảm ơn quý khách đã quan tâm đến giải pháp CRM Automation.';\nconst messageHtml = rawMessage.replace(/\\n/g, '<br/>');\n\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin: 0; padding: 24px 0; background-color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\">\n  <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;\">\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #059669 0%, #0d9488 100%); padding: 36px 32px; text-align: center;\">\n              <div style=\"display: inline-block; background-color: rgba(255, 255, 255, 0.2); padding: 6px 16px; border-radius: 20px; color: #ffffff; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px;\">\n                ⚡ CRM AUTOMATION PLATFORM\n              </div>\n              <h1 style=\"color: #ffffff; margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.5px; line-height: 1.3;\">\n                ${subject}\n              </h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 36px 32px; color: #334155; font-size: 15px; line-height: 1.7;\">\n              <div style=\"background-color: #f8fafc; border-left: 4px solid #059669; padding: 18px 20px; border-radius: 0 10px 10px 0; margin-bottom: 24px; font-size: 15px; color: #1e293b;\">\n                ${messageHtml}\n              </div>\n              <div style=\"text-align: center; margin: 32px 0 16px 0;\">\n                <a href=\"https://crm-automation-frontend.vercel.app\" style=\"background: linear-gradient(135deg, #059669 0%, #0d9488 100%); color: #ffffff; padding: 14px 32px; border-radius: 10px; font-weight: 700; text-decoration: none; display: inline-block; font-size: 14px; box-shadow: 0 4px 14px rgba(5, 150, 105, 0.35);\">\n                  👉 Xem Chi Tiết Trên Hệ Thống CRM\n                </a>\n              </div>\n              <p style=\"margin-bottom: 0; font-size: 14px; color: #64748b;\">\n                Trân trọng,<br/>\n                <strong style=\"color: #0f172a;\">Đội ngũ CRM Automation</strong>\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"background-color: #f8fafc; padding: 24px 32px; text-align: center; border-top: 1px solid #e2e8f0; color: #64748b; font-size: 12px; line-height: 1.6;\">\n              <p style=\"margin: 0 0 6px 0; font-weight: 600; color: #475569;\">CRM Automation Platform • Enterprise Edition 2026</p>\n              <p style=\"margin: 0;\">Email này được điều phối tự động bởi Follow-up Sequence Engine.</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    recipientEmail: recipient,\n    emailSubject: subject,\n    emailBody: rawMessage,\n    emailHtml: html\n  }\n}];"
      },
