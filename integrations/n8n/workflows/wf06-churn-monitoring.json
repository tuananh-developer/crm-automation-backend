          }
        ]
      ]
    },
    "9. AI Explanation": {
      "main": [
        [
          {
            "node": "10. Validate AI Explanation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "10. Validate AI Explanation": {
      "main": [
        [
          {
            "node": "11. Gate Retention",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "11. Gate Retention": {
      "main": [
        [
          {
            "node": "12. Create Retention Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    "WF06",
    "churn-monitoring",
    "phase-4"
  ]
}
