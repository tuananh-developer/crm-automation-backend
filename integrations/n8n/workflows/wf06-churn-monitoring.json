          }
        ]
      ]
    },
    "7. Backend Churn Assessment": {
      "main": [
        [
          {
            "node": "8. Validate Assessment Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "8. Validate Assessment Result": {
      "main": [
        [
          {
            "node": "9. AI Explanation",
            "type": "main",
