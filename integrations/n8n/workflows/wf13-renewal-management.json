{
  "name": "WF13 - Renewal Management",
  "nodes": [
    {
      "name": "1. Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "w1"
    },
    {
      "name": "2. Fetch Renewal Contracts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/renewal/contracts?days=30",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "w2"
    },
    {
      "name": "3. Split Contracts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        400,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "w3"
    },
    {
      "name": "4. Fetch Current Contract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/renewal/contracts/{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "id": "w4"
    },
    {
      "name": "5. Calculate Urgency",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/renewal/urgency",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ renewalDate: $json.renewalDate }) }}"
      },
      "id": "w5"
    },
    {
      "name": "6. Generate AI Draft",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "Generate renewal recommendation",
              "role": "user"
            }
          ]
        }
      },
      "id": "w6"
    },
    {
      "name": "7. Validate Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/renewal/validate-draft",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contractId: $('4. Fetch Current Contract').item.json.id, customerId: $('4. Fetch Current Contract').item.json.customerId, renewalDate: $('4. Fetch Current Contract').item.json.renewalDate, sourceContractId: $('4. Fetch Current Contract').item.json.id, sourceCustomerId: $('4. Fetch Current Contract').item.json.customerId }) }}"
      },
      "id": "w7"
    },
    {
      "name": "8. Save Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/renewal/drafts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contractId: $('4. Fetch Current Contract').item.json.id, customerId: $('4. Fetch Current Contract').item.json.customerId, idempotencyKey: $('4. Fetch Current Contract').item.json.id + ':renewal' }) }}"
      },
      "id": "w8"
    },
    {
      "name": "9. Check Eligibility",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/renewal/check-eligibility",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ hasConsent: true, hasTemplate: true, policyAllows: true, needsApproval: false }) }}"
      },
      "id": "w9"
    },
    {
      "name": "10. IF Auto-send",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.canAutoSend }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "w10"
    },
    {
      "name": "11. Send Communication",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/internal/communication/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: 'test@example.com', subject: 'Renewal', text: 'Renewal notice' }) }}"
      },
      "id": "w11"
    },
    {
      "name": "12. Handle Errors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        200
      ],
      "parameters": {
        "jsCode": "console.log('Error handled'); return [{ json: { handled: true } }];"
      },
      "id": "w12"
    },
    {
      "name": "13. Create CustomerTask",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/customer-tasks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ customerId: $('4. Fetch Current Contract').item.json.customerId, taskType: 'RENEWAL', priority: 'HIGH', idempotencyKey: $('4. Fetch Current Contract').item.json.id + ':renewal' }) }}"
      },
      "id": "w13"
    },
    {
      "name": "14. Notify Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/notifications/internal/create",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'FOLLOW_UP_FAILED', severity: 'MEDIUM', title: 'Renewal action required', message: 'Renewal pending approval' }) }}"
      },
      "id": "w14"
    },
    {
      "name": "15. Update Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { status: 'COMPLETED' } }];"
      },
      "id": "w15"
    },
    {
      "name": "16. Log Execution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        0
      ],
      "parameters": {
        "jsCode": "console.log('WF13 completed'); return [{ json: { logged: true } }];"
      },
      "id": "w16"
    }
  ],
  "connections": {
    "1. Daily Schedule": {
      "main": [
        [
          {
            "node": "2. Fetch Renewal Contracts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Fetch Renewal Contracts": {
      "main": [
        [
          {
            "node": "3. Split Contracts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Split Contracts": {
      "main": [
        [
          {
            "node": "4. Fetch Current Contract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. Fetch Current Contract": {
      "main": [
        [
          {
            "node": "5. Calculate Urgency",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "5. Calculate Urgency": {
      "main": [
        [
          {
            "node": "6. Generate AI Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "6. Generate AI Draft": {
      "main": [
        [
          {
            "node": "7. Validate Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "7. Validate Draft": {
      "main": [
        [
          {
            "node": "8. Save Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "8. Save Draft": {
      "main": [
        [
          {
            "node": "9. Check Eligibility",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "9. Check Eligibility": {
      "main": [
        [
          {
            "node": "10. IF Auto-send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "10. IF Auto-send": {
      "main": [
        [
          {
            "node": "11. Send Communication",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "13. Create CustomerTask",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "12. Handle Errors": {
      "main": [
        [
          {
            "node": "13. Create CustomerTask",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "13. Create CustomerTask": {
      "main": [
        [
          {
            "node": "14. Notify Owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "15. Update Status": {
      "main": [
        [
          {
            "node": "16. Log Execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "11. Send Communication": {
      "main": [
        [
          {
            "node": "15. Update Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "14. Notify Owner": {
      "main": [
        [
          {
            "node": "15. Update Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}