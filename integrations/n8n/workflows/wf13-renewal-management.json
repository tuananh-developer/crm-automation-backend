    {
      "id": "wf13-calc-urgency",
      "name": "Code: Calculate Renewal Urgency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const renewalDate = $json.renewalDate || $json.renewal_date;\nconst date = renewalDate ? new Date(renewalDate) : null;\nconst now = new Date();\nconst ms = date ? date.getTime() - now.getTime() : null;\nconst daysRemaining = date ? Math.ceil(ms / (1000 * 60 * 60 * 24)) : -1;\nconst urgency = !date ? 'UNKNOWN' : daysRemaining < 0 ? 'EXPIRED' : daysRemaining <= 7 ? 'CRITICAL' : daysRemaining <= 30 ? 'HIGH' : daysRemaining <= 60 ? 'MEDIUM' : 'LOW';\nreturn [{ json: { ...$json, renewalDate: date ? date.toISOString() : null, daysRemaining, urgency } }];"
      }
    },
    {
      "id": "wf13-ai-recommendation",
      "name": "HTTP: AI Renewal Recommendation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_PROVIDER_URL || 'https://example.invalid/renewal-recommendation' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contractId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "customerId",
              "value": "={{ $json.customerId }}"
            },
            {
              "name": "urgency",
              "value": "={{ $json.urgency }}"
            },
            {
              "name": "renewalDate",
              "value": "={{ $json.renewalDate }}"
            }
          ]
        },
        "options": {
          "responseFormat": "json",
          "ignoreResponseCode": false
        },
        "continueOnFail": true
      }
    },
    {
      "id": "wf13-validate-draft",
      "name": "Code: Validate Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const contractId = $json.id || $json.contractId;\nconst customerId = $json.customerId;\nconst renewalDate = $json.renewalDate || $json.renewal_date;\nconst valid = Boolean(contractId && customerId && renewalDate);\nreturn [{ json: { ...$json, validDraft: valid, contractId, customerId, renewalDate } }];"
      }
    },
    {
      "id": "wf13-save-draft",
      "name": "HTTP: Save Renewal Draft",
