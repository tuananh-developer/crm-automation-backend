        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        }
      },
      "id": "e6047c3e-324f-4d92-9111-c11100000002",
      "name": "HTTP Request: Get Contracts Due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        340,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst list = Array.isArray(raw) ? raw : (raw.data || [raw]);\nif (!list || list.length === 0) return [];\nreturn list.filter(item => item && item.id).map(c => ({ json: c }));"
      },
      "id": "e6047c3e-324f-4d92-9111-c11100000003",
      "name": "Split Out: Contract Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.BACKEND_INTERNAL_URL || 'http://localhost:3000') + '/api/v1/internal/n8n/renewal/contracts/' + $json.id }}",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        }
      },
      "id": "e6047c3e-324f-4d92-9111-c11100000004",
      "name": "HTTP Request: Get Contract/Customer Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        820,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const contract = $json;\nconst renewalDate = contract.renewalDate ? new Date(contract.renewalDate) : null;\nif (!renewalDate || isNaN(renewalDate.getTime())) {\n  return { ...contract, urgency: 'UNKNOWN', daysRemaining: -1 };\n}\nconst now = new Date();\nconst diff = renewalDate.getTime() - now.getTime();\nconst days = Math.ceil(diff / (24 * 60 * 60 * 1000));\nlet level = 'LOW';\nif (days < 0) level = 'EXPIRED';\nelse if (days <= 7) level = 'CRITICAL';\nelse if (days <= 30) level = 'HIGH';\nelse if (days <= 60) level = 'MEDIUM';\nreturn { ...contract, urgency: level, daysRemaining: days };"
      },
      "id": "e6047c3e-324f-4d92-9111-c11100000005",
      "name": "Code: Calculate Renewal Urgency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.BACKEND_INTERNAL_URL || 'http://localhost:3000') + '/api/v1/internal/n8n/renewal/validate-draft' }}",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contractId: $json.id, customerId: $json.customerId, renewalDate: $json.renewalDate, urgency: $json.urgency, sourceContractId: $json.id, sourceCustomerId: $json.customerId, recommendation: 'Standard renewal terms review for ' + $json.contractNumber, draftContent: 'Dear customer, your contract ' + $json.contractNumber + ' is scheduled for renewal on ' + $json.renewalDate + '. Please review our proposed renewal options.' } }}"
      },
      "id": "e6047c3e-324f-4d92-9111-c11100000006",
      "name": "HTTP Request: AI Renewal Recommendation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1300,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const contract = $node['Code: Calculate Renewal Urgency'].json;\nconst validation = $json;\nconst contractId = contract.id;\nconst customerId = contract.customerId;\nconst isGrounded = Boolean(contractId && customerId && validation.valid !== false);\nreturn {\n  contractId,\n  customerId,\n  renewalDate: contract.renewalDate,\n  urgency: contract.urgency,\n  recommendation: 'Standard renewal terms review for ' + contract.contractNumber,\n  draftContent: 'Dear customer, your contract ' + contract.contractNumber + ' is scheduled for renewal on ' + contract.renewalDate + '. Please review our proposed renewal options.',\n  validationResult: {\n    grounded: isGrounded,\n    consentGranted: false,\n    templateApproved: false,\n    policyApproved: false\n  },\n  canAutoSend: false,\n  idempotencyKey: 'renewal-draft-' + contractId + '-' + (contract.renewalDate ? String(contract.renewalDate).substring(0, 10) : 'cycle')\n};"
      },
      "id": "e6047c3e-324f-4d92-9111-c11100000007",
      "name": "Code: Validate Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.BACKEND_INTERNAL_URL || 'http://localhost:3000') + '/api/v1/internal/n8n/renewal/drafts' }}",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.N8N_API_KEY }}"
