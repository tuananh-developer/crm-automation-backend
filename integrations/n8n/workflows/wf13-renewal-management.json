        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contractId: $json.contractId, customerId: $json.customerId, renewalDate: $json.renewalDate, urgency: $json.urgency, recommendation: $json.recommendation, draftContent: $json.draftContent, validationResult: $json.validationResult, idempotencyKey: $json.idempotencyKey } }}"
      },
      "id": "e6047c3e-324f-4d92-9111-c11100000008",
      "name": "HTTP Request: Save Renewal Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1780,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "conditions": {
