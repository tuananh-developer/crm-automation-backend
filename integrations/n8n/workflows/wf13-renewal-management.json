              "value": "={{ $json.renewalDate }}"
            },
            {
              "name": "urgency",
              "value": "={{ $json.urgency }}"
            },
            {
              "name": "idempotencyKey",
              "value": "={{ $json.id }}-{{ $json.renewalDate }}"
            },
            {
              "name": "draftContent",
              "value": "={{ $json.recommendation || 'Renewal follow-up recommended.' }}"
            }
          ]
        },
        "options": {
          "responseFormat": "json",
          "ignoreResponseCode": false
