      ],
      "parameters": {
        "jsCode": "const response = $json || {};\nconst result = {\n  workflowName: 'WF13 - Renewal Management',\n  contractId: response.contractId || response.id || null,\n  customerId: response.customerId || null,\n  urgency: response.urgency || 'UNKNOWN',\n  canAutoSend: Boolean(response.canAutoSend),\n  status: response.status || 'COMPLETED',\n  processedAt: new Date().toISOString()\n};\nreturn [{ json: result }];"
      }
    }
