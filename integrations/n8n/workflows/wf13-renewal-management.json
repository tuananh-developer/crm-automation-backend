      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.NESTJS_API_URL || 'http://localhost:3000' }}/api/v1/internal/n8n/renewal/contracts/{{$json.id}}",
        "options": {
          "responseFormat": "json",
          "ignoreResponseCode": false
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "nodeCredentialType": "httpHeaderAuth",
        "headerParameters": {
