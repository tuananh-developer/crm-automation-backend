      "parameters": {
        "method": "GET",
        "url": "={{ ($env.BACKEND_INTERNAL_URL || 'http://localhost:3000') + '/api/v1/internal/n8n/renewal/contracts?days=30' }}",
        "options": {
          "timeout": 15000
