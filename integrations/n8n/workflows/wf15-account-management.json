    "9. Fetch Open Issues and Renewals": {"main": [[{"node": "10. Normalize Account Data", "type": "main", "index": 0}]]},
    "10. Normalize Account Data": {"main": [[{"node": "11. Validate Data Coverage", "type": "main", "index": 0}]]},
    "11. Validate Data Coverage": {"main": [[{"node": "12. Call Backend Account Health API", "type": "main", "index": 0}]]},
