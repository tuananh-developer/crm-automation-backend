{
  "name": "WF15 - Account Management",
  "nodes": [
    {
      "name": "1. Weekly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [{"field": "weeks", "weeksInterval": 1}]
        }
      },
      "id": "n1"
    },
    {
      "name": "2. Fetch Strategic Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/customers?isStrategic=true&limit=100\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        }
      },
      "id": "n2"
    },
    {
      "name": "3. Validate Strategic Accounts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 0],
      "parameters": {
        "jsCode": "const items = $input.all(); return items.filter(i => i.json.isStrategic === true);"
      },
      "id": "n3"
    },
    {
      "name": "4. Split Out Accounts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [600, 0],
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "n4"
    },
    {
      "name": "5. Fetch Customer Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/customers/\" + $json.id + \"\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        }
      },
      "id": "n5"
    },
    {
      "name": "6. Fetch Customer Interactions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/customers/\" + $json.id + \"/interactions\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        }
      },
      "id": "n6"
    },
    {
      "name": "7. Fetch Follow-up History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/follow-up/enrollments?customerId=\" + $json.id + \"\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        }
      },
      "id": "n7"
    },
    {
      "name": "8. Fetch Feedback History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/feedback?customerId=\" + $json.id + \"\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        }
      },
      "id": "n8"
    },
    {
      "name": "9. Fetch Open Issues and Renewals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/customers/\" + $json.id + \"/issues-renewals\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        }
      },
      "id": "n9"
    },
    {
      "name": "10. Normalize Account Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 0],
      "parameters": {
        "jsCode": "const d = $json;\nconst interactions = $('6. Fetch Customer Interactions').first().json;\nconst followups = $('7. Fetch Follow-up History').first().json;\nconst feedback = $('8. Fetch Feedback History').first().json;\nconst issuesRenewals = $('9. Fetch Open Issues and Renewals').first().json;\nconst interactionList = Array.isArray(interactions) ? interactions : (interactions?.data || []);\nconst followupList = Array.isArray(followups) ? followups : (followups?.data || []);\nconst feedbackList = Array.isArray(feedback) ? feedback : (feedback?.data || []);\nconst issuesList = Array.isArray(issuesRenewals) ? issuesRenewals : (issuesRenewals?.data || issuesRenewals?.issues || []);\nconst engagement = interactionList.length > 0 ? Math.min(100, Math.round(interactionList.length * 10)) : null;\nconst feedbackScore = feedbackList.length > 0 ? Math.min(100, Math.round(feedbackList.reduce((s, f) => s + (Number(f.rating || f.score || 0)), 0) / feedbackList.length)) : null;\nconst openIssues = Array.isArray(issuesList) ? issuesList.length : null;\nconst followUpCompletion = followupList.length > 0 ? Math.min(100, Math.round((followupList.filter(f => f.status === 'COMPLETED' || f.status === 'SUCCESS').length / followupList.length) * 100)) : null;\nreturn [{ json: { customerId: d.id, engagement, feedback: feedbackScore, openIssues, followUpCompletion, sources: { interactions: interactionList.length, followups: followupList.length, feedback: feedbackList.length, issues: Array.isArray(issuesList) ? issuesList.length : 0 } } }];"
      },
      "id": "n10"
    },
    {
      "name": "11. Validate Data Coverage & Call Health API",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 0],
      "parameters": {
        "jsCode": "const d = $json;\nconst missing = [];\nif (d.engagement === null) missing.push('engagement');\nif (d.feedback === null) missing.push('feedback');\nif (d.openIssues === null) missing.push('openIssues');\nif (d.followUpCompletion === null) missing.push('followUpCompletion');\nconst hasSufficientData = missing.length === 0;\nreturn [{ json: { ...d, missingData: missing, hasSufficientData } }];"
      },
      "id": "n11"
    },
    {
      "name": "12. Call Backend Account Health API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/account-health/calculate\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ customerId: $json.customerId, engagement: $json.engagement, feedback: $json.feedback, openIssues: $json.openIssues, followUpCompletion: $json.followUpCompletion, evidence: $json.sources, missingData: $json.missingData }) }}"
      },
      "id": "n12"
    },
    {
      "name": "13. Check Account Health Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2400, 0],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [{"id": "c1", "leftValue": "={{ $json.status }}", "rightValue": "INSUFFICIENT_DATA", "operator": {"type": "string", "operation": "notEquals"}}],
          "combinator": "and"
        }
      },
      "id": "n13"
    },
    {
      "name": "14. Call AI Explanation",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [2600, 0],
      "parameters": {
        "modelId": {"__rl": true, "value": "gpt-4o-mini", "mode": "list"},
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "={{ `Customer ${{ $json.customerId }} health assessment:\nScore: ${{ $json.score }}\nStatus: ${{ $json.status }}\nBreakdown: ${{ JSON.stringify($json.breakdown) }}\nEvidence: ${{ JSON.stringify($json.evidence) }}\n\nExplain the result and suggest 3-5 specific retention actions in JSON format: {\"recommendedActions\": [\"action1\", \"action2\", ...], \"hasRiskOrOpportunity\": true/false}` }}"
            }
          ]
        }
      },
      "id": "n14"
    },
    {
      "name": "15. Parse AI Output & Derive Flags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2800, 0],
      "parameters": {
        "jsCode": "const ai = $json;\nlet recommendedActions = [];\nlet hasRiskOrOpportunity = false;\ntry {\n  const parsed = typeof ai === 'string' ? JSON.parse(ai) : ai;\n  recommendedActions = Array.isArray(parsed.recommendedActions) ? parsed.recommendedActions : [];\n  hasRiskOrOpportunity = Boolean(parsed.hasRiskOrOpportunity);\n} catch (e) {\n  console.warn('Failed to parse AI output:', e);\n}\nconst data = $('12. Call Backend Account Health API').first().json;\nconst customerId = $('10. Normalize Account Data').item.json.customerId;\nreturn [{ json: { customerId, ...data, recommendedActions, hasRiskOrOpportunity, aiOutput: ai } }];"
      },
      "id": "n15"
    },
    {
      "name": "16. Validate Actions & Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3000, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/account-health/validate-actions\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ customerId: $('10. Normalize Account Data').item.json.customerId, snapshotId: $('12. Call Backend Account Health API').item.json.id, actions: $json.recommendedActions || [] }) }}"
      },
      "id": "n16"
    },
    {
      "name": "17. Save Snapshot & Check Risk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3200, 0],
      "parameters": {
        "jsCode": "const data = $('12. Call Backend Account Health API').first().json;\nconst customerId = $('10. Normalize Account Data').item.json.customerId;\nconst hasRisk = $('15. Parse AI Output & Derive Flags').item.json.hasRiskOrOpportunity;\nreturn [{ json: { customerId, ...data, hasRiskOrOpportunity: hasRisk, savedAt: new Date().toISOString() } }];"
      },
      "id": "n17"
    },
    {
      "name": "18. Check Risk or Opportunity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3400, 0],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [{"id": "c2", "leftValue": "={{ $json.hasRiskOrOpportunity }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true"}}],
          "combinator": "and"
        }
      },
      "id": "n18"
    },
    {
      "name": "19. Create Retention Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3600, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/customers/tasks\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ customerId: $('10. Normalize Account Data').item.json.customerId, taskType: 'RETENTION', priority: 'HIGH', idempotencyKey: $('10. Normalize Account Data').item.json.customerId + ':account-health:retention' }) }}"
      },
      "id": "n19"
    },
    {
      "name": "20. Notify Account Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3800, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.CRM_BACKEND_URL || $env.CRM_API_BASE_URL || \"http://localhost:3000\") + \"/api/v1/internal/n8n/notifications/internal/create\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Accept", "value": "application/json"},
            {"name": "x-n8n-api-key", "value": "={{ $env.N8N_API_KEY }}"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'FOLLOW_UP_FAILED', severity: 'MEDIUM', title: 'Account action required', message: 'Action required for account ' + $('10. Normalize Account Data').item.json.customerId }) }}"
      },
      "id": "n20"
    },
    {
      "name": "21. Loop Back",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3600, 300],
      "parameters": {},
      "id": "n21"
    }
  ],
  "connections": {
