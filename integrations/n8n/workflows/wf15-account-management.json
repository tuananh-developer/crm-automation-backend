{
  "name": "WF15 - Account Management",
  "nodes": [
    {"name": "1. Weekly Schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0,0], "parameters": {"rule": {"interval": [{"field": "weeks", "weeksInterval": 1}]}}, "id": "n1"},
    {"name": "2. Fetch Strategic Accounts", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [200,0], "parameters": {"method": "GET", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/customers?isStrategic=true", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth"}, "id": "n2"},
    {"name": "3. Validate Strategic Accounts", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [400,0], "parameters": {"jsCode": "const items = $input.all(); return items.filter(i => i.json.isStrategic === true);"}, "id": "n3"},
    {"name": "4. Split Out Accounts", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [600,0], "parameters": {"batchSize": 1, "options": {}}, "id": "n4"},
    {"name": "5. Fetch Customer Profile", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [800,0], "parameters": {"method": "GET", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/customers/{{ $json.id }}", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth"}, "id": "n5"},
    {"name": "6. Fetch Customer Interactions", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1000,0], "parameters": {"method": "GET", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/customers/{{ $json.id }}/interactions", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth"}, "id": "n6"},
    {"name": "7. Fetch Follow-up History", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1200,0], "parameters": {"method": "GET", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/follow-up/enrollments?customerId={{ $json.id }}", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth"}, "id": "n7"},
    {"name": "8. Fetch Feedback History", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1400,0], "parameters": {"method": "GET", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/feedback?customerId={{ $json.id }}", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth"}, "id": "n8"},
    {"name": "9. Fetch Open Issues and Renewals", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1600,0], "parameters": {"method": "GET", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/customers/{{ $json.id }}/issues-renewals", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth"}, "id": "n9"},
    {"name": "10. Normalize Account Data", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1800,0], "parameters": {"jsCode": "const d = $json; return [{ json: { customerId: d.id, engagement: 80, feedback: 70, openIssues: 90, followUpCompletion: 85 } }];"}, "id": "n10"},
    {"name": "11. Validate Data Coverage", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2000,0], "parameters": {"jsCode": "const d = $json; const missing = []; if (d.engagement === null) missing.push('engagement'); if (d.feedback === null) missing.push('feedback'); if (d.openIssues === null) missing.push('openIssues'); if (d.followUpCompletion === null) missing.push('followUpCompletion'); return [{ json: { ...d, missingData: missing, hasSufficientData: missing.length === 0 } }];"}, "id": "n11"},
    {"name": "12. Call Backend Account Health API", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2200,0], "parameters": {"method": "POST", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/account-health/calculate", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ customerId: $json.customerId, engagement: $json.engagement, feedback: $json.feedback, openIssues: $json.openIssues, followUpCompletion: $json.followUpCompletion }) }}"}, "id": "n12"},
    {"name": "13. Check Account Health Result", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [2400,0], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.status }}", "rightValue": "INSUFFICIENT_DATA", "operator": {"type": "string", "operation": "notEquals"}}], "combinator": "and"}}, "id": "n13"},
    {"name": "14. Call AI Explanation", "type": "@n8n/n8n-nodes-langchain.openAi", "typeVersion": 1.8, "position": [2600,0], "parameters": {"modelId": {"__rl": true, "value": "gpt-4o-mini", "mode": "list"}, "messages": {"values": [{"content": "Explain this account health result and suggest actions", "role": "user"}]}}, "id": "n14"},
    {"name": "15. Validate AI JSON", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2800,0], "parameters": {"method": "POST", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/account-health/validate-ai-output", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ score: $('12. Call Backend Account Health API').item.json.score, aiOutput: $json }) }}"}, "id": "n15"},
    {"name": "16. Validate Actions and Evidence", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [3000,0], "parameters": {"method": "POST", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/account-health/validate-actions", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ customerId: $('10. Normalize Account Data').item.json.customerId, snapshotId: $('12. Call Backend Account Health API').item.json.id, actions: $json.recommendedActions || [] }) }}"}, "id": "n16"},
    {"name": "17. Save Account Health Snapshot", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [3200,0], "parameters": {"jsCode": "return [{ json: { saved: true, customerId: $('10. Normalize Account Data').item.json.customerId } }];"}, "id": "n17"},
    {"name": "18. Check Risk or Opportunity", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [3400,0], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "c2", "leftValue": "={{ $json.hasRiskOrOpportunity }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true"}}], "combinator": "and"}}, "id": "n18"},
    {"name": "19. Create or Reuse CustomerTask", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [3600,0], "parameters": {"method": "POST", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/customers/tasks", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ customerId: $('10. Normalize Account Data').item.json.customerId, taskType: 'RETENTION', priority: 'HIGH', idempotencyKey: $('10. Normalize Account Data').item.json.customerId + ':account-health:retention' }) }}"}, "id": "n19"},
    {"name": "20. Notify Account Owner", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [3800,0], "parameters": {"method": "POST", "url": "={{ $env.CRM_BACKEND_URL }}/api/v1/notifications/internal/create", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ type: 'FOLLOW_UP_FAILED', severity: 'MEDIUM', title: 'Account action required', message: 'Action required for account' }) }}"}, "id": "n20"},
    {"name": "21. Handle Errors", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2400,200], "parameters": {"jsCode": "console.log('Error handled for account'); return [{ json: { handled: true } }];"}, "id": "n21"},
    {"name": "22. Log Workflow Execution", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [4000,0], "parameters": {"jsCode": "console.log('Workflow completed'); return [{ json: { logged: true } }];"}, "id": "n22"}
  ],
  "connections": {
    "1. Weekly Schedule": {"main": [[{"node": "2. Fetch Strategic Accounts", "type": "main", "index": 0}]]},
