FROM alpine:3.22

WORKDIR /bundle

COPY deploy/compose.production.yml /bundle/compose.production.yml
COPY deploy/Caddyfile /bundle/Caddyfile
COPY deploy/rabbitmq/rabbitmq.conf /bundle/rabbitmq/rabbitmq.conf
COPY deploy/rabbitmq/definitions.json /bundle/rabbitmq/definitions.json
COPY deploy/check-env.sh /bundle/check-env.sh
COPY deploy/ssm-deploy-image.sh /bundle/ssm-deploy-image.sh
COPY deploy/configure-tailscale-serve.sh /bundle/configure-tailscale-serve.sh
COPY deploy/bootstrap-ec2.sh /bundle/bootstrap-ec2.sh
COPY deploy/.env.production.example /bundle/.env.production.example
COPY deploy/install-config.sh /bundle/install-config.sh

RUN chmod 0755 /bundle/install-config.sh /bundle/check-env.sh /bundle/ssm-deploy-image.sh /bundle/configure-tailscale-serve.sh /bundle/bootstrap-ec2.sh

ENTRYPOINT ["/bin/sh", "/bundle/install-config.sh"]
