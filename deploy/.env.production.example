# DNS: point both A records to the EC2 public IPv4 (prefer a stable Elastic IP).
CRM_DOMAIN=crm.example.com
N8N_DOMAIN=n8n.example.com
ACME_EMAIL=ops@example.com

# Docker Hub images are built by GitHub Actions; EC2 only pulls immutable tags.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# PostgreSQL bootstrap administrator (not used by the application).
POSTGRES_ADMIN_USER=crm_postgres_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX

# Dedicated least-privilege database owners.
LOCAL_DB_HOST=postgres
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=crm_backend
LOCAL_DB_USER=crm_app
LOCAL_DB_PASSWORD=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX

N8N_DB_NAME=crm_n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX

# RabbitMQ is private to the Compose network; do not publish 5672/15672.
LOCAL_RABBITMQ_HOST=rabbitmq
LOCAL_RABBITMQ_PORT=5672
LOCAL_RABBITMQ_USER=crm_broker
LOCAL_RABBITMQ_PASSWORD=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX

# Explicit opt-in for the self-hosted private DB and broker in production.
NODE_ENV=production
USE_LOCAL_DB=true
USE_LOCAL_AMQP=true
USE_CLOUD_AMQP=false
ALLOW_LOCAL_INFRA_IN_PRODUCTION=true
DATABASE_URL=
RABBITMQ_URL=
DB_SSL=false

# Application and n8n shared secrets. Generate unique values; never commit real values.
JWT_SECRET=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX
N8N_API_KEY=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX
N8N_WEBHOOK_SECRET=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX
N8N_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Backend-owned email delivery (configure before enabling email workflows).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.com
N8N_WEBHOOK_TIMEOUT_MS=45000

# Observability credentials are optional until configured.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

TRANSCRIPT_EXTERNAL_PROCESSING_ENABLED=false
N8N_WORKFLOW_CLAIM_LEASE_SECONDS=1200
QUOTE_APPROVAL_THRESHOLD=0