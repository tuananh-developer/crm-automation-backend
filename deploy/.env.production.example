# Public endpoints. Use the EC2 public IPv4 with nip.io for the initial demo,
# or replace these with DNS names you control.
API_DOMAIN=api.203.0.113.10.nip.io
N8N_DOMAIN=n8n.203.0.113.10.nip.io
ACME_EMAIL=you@example.com
FRONTEND_URL=https://crm-automation-frontend.vercel.app

# The frontend stays on Vercel. EC2 only pulls the backend image.
BACKEND_IMAGE_TAG=latest

# Production database for the CRM API (Neon PostgreSQL connection string).
# Prefer the direct Neon endpoint for the migration runner; keep sslmode=require.
DATABASE_URL=postgresql://crm_role:REPLACE_WITH_DATABASE_PASSWORD@ep-example.region.aws.neon.tech/crm_backend?sslmode=require

# RabbitMQ is private to the EC2 Compose network.
NODE_ENV=production
ALLOW_LOCAL_INFRA_IN_PRODUCTION=true
USE_LOCAL_DB=false
USE_LOCAL_AMQP=true
USE_CLOUD_AMQP=false
RABBITMQ_URL=
LOCAL_RABBITMQ_HOST=rabbitmq
LOCAL_RABBITMQ_PORT=5672
LOCAL_RABBITMQ_USER=crm_broker
LOCAL_RABBITMQ_PASSWORD=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX

# n8n uses a separate database and role in Neon PostgreSQL.
N8N_DB_HOST=ep-example.region.aws.neon.tech
N8N_DB_PORT=5432
N8N_DB_NAME=crm_n8n
N8N_DB_USER=n8n_role
N8N_DB_PASSWORD=REPLACE_WITH_N8N_DATABASE_PASSWORD
N8N_DB_SSL_ENABLED=true
N8N_DB_SSL_REJECT_UNAUTHORIZED=true

# Application and n8n machine-to-machine secrets. Generate unique values.
JWT_SECRET=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX
N8N_API_KEY=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX
N8N_WEBHOOK_SECRET=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX
N8N_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RANDOM_32_BYTE_HEX

# Private service URLs used by backend-to-n8n calls.
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_WF10_WEBHOOK_URL=
N8N_WF11_WEBHOOK_URL=
N8N_WF12_WEBHOOK_URL=

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Backend-owned email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.com
N8N_WEBHOOK_TIMEOUT_MS=45000

# Observability
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

TRANSCRIPT_EXTERNAL_PROCESSING_ENABLED=false
N8N_WORKFLOW_CLAIM_LEASE_SECONDS=1200
QUOTE_APPROVAL_THRESHOLD=0
