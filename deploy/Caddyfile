{
  email {$ACME_EMAIL}
  admin off
}

{$CRM_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  @backend_api path /api/*
  handle @backend_api {
    reverse_proxy backend:3000
  }

  handle {
    reverse_proxy frontend:3001
  }
}

{$N8N_DOMAIN} {
  encode zstd gzip
  reverse_proxy n8n:5678
}
