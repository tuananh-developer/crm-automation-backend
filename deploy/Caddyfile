{
  email {$ACME_EMAIL}
  admin off
}

{$API_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy backend:3000
}

{$N8N_WEBHOOK_DOMAIN} {
  encode zstd gzip

  @n8n_public_endpoints path /webhook/* /webhook-test/* /webhook-waiting/* /form/* /form-test/* /form-waiting/*
  handle @n8n_public_endpoints {
    reverse_proxy n8n:5678
  }

  handle {
    respond "Not Found" 404
  }
}
