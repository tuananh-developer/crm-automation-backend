      * id : uuid <<PK>>
      --
      customer_id : uuid <<FK>>
      title : varchar
      description : text?
      category : varchar
      severity : varchar
      status : varchar
      assigned_to : uuid? <<FK>>
      created_by : uuid? <<FK>>
      opened_at : timestamptz
      resolved_at : timestamptz?
      created_at : timestamptz
      updated_at : timestamptz
    }

    entity customer_churn_assessments <<TABLE>> {
      * id : uuid <<PK>>
      --
      customer_id : uuid <<FK>>
      workflow_run_id : uuid? <<FK>>
      risk_score : numeric?
      risk_level : varchar
      contributing_factors : jsonb
      explanation : text?
      policy_version : varchar
      assessment_status : varchar
      assessed_at : timestamptz
