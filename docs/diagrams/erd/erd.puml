@startuml
title AI CRM Automation System - ERD V2

' ============================================================
' GLOBAL SETTINGS
' ============================================================

hide methods
hide stereotypes

skinparam linetype ortho
skinparam shadowing false

skinparam entity {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
    ArrowColor #475569
}

skinparam package {
    BackgroundColor #F1F5F9
    BorderColor #64748B
    FontColor #0F172A
}

' ============================================================
' DOMAIN VALUE NOTES
' ============================================================

note as DOMAIN_VALUES
Suggested domain values

USER_ROLE
- ADMIN
- SALES

USER_STATUS
- ACTIVE
- INACTIVE
- LOCKED

LEAD_STATUS
- NEW
- QUALIFYING
- QUALIFIED
- NURTURING
- CONVERTED
- LOST

QUALIFICATION_STATUS
- QUALIFIED
- DISQUALIFIED
- NEEDS_REVIEW

ENRICHMENT_STATUS
- PENDING
- SUCCESS
- FAILED
- PARTIAL

SCORE_LABEL
- HOT
- WARM
- COLD

FOLLOW_UP_SEQUENCE_STATUS
- DRAFT
- ACTIVE
- PAUSED
- COMPLETED
- ARCHIVED

ENROLLMENT_STATUS
- ACTIVE
- PAUSED
- COMPLETED
- CANCELLED

EXECUTION_STATUS
- PENDING
- RUNNING
- SUCCESS
- FAILED
- SKIPPED

REVIEW_STATUS
- PENDING
- IN_REVIEW
- APPROVED
- REJECTED
- RESOLVED

REVIEW_DECISION
- APPROVE
- REJECT
- MODIFY

SEGMENT_ASSIGNMENT_TYPE
- MANUAL
- RULE
- AI

WORKFLOW_STATUS
- PENDING
- RUNNING
- SUCCESS
- FAILED
- CANCELLED
end note

' ============================================================
' 1. IDENTITY & ACCESS
' ============================================================

package "1. Identity & Access" {

    entity "USERS" as users {

        * id : UUID <<PK>>
        --
        * name : VARCHAR(150)
        * email : VARCHAR(320) <<UK>>
        * password_hash : VARCHAR(255)

        * role : VARCHAR(30)
        * status : VARCHAR(30)

        last_login_at : TIMESTAMPTZ

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }
}

' ============================================================
' 2. LEAD MANAGEMENT
' ============================================================

package "2. Lead Management" {

    entity "LEAD_SOURCES" as lead_sources {

        * id : UUID <<PK>>
        --
        * name : VARCHAR(100) <<UK>>
        description : TEXT

        is_active : BOOLEAN

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }


    entity "LEADS" as leads {

        * id : UUID <<PK>>
        --

        * first_name : VARCHAR(100)
        last_name : VARCHAR(100)

        * email : VARCHAR(320)
        phone : VARCHAR(30)

        company_name : VARCHAR(255)
        company_website : VARCHAR(500)
        job_title : VARCHAR(150)
        company_size : INTEGER
        industry : VARCHAR(150)

        * status : VARCHAR(30)

        * source_id : UUID <<FK>>
        owner_id : UUID <<FK, NULL>>

        converted_customer_id : UUID <<FK, NULL>>
        converted_by : UUID <<FK, NULL>>
        converted_at : TIMESTAMPTZ

        notes : TEXT

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }


    entity "INTERACTIONS" as interactions {

        * id : UUID <<PK>>
        --

        * lead_id : UUID <<FK>>

        * type : VARCHAR(50)
        channel : VARCHAR(50)

        subject : VARCHAR(255)
        content : TEXT

        metadata : JSONB

        * occurred_at : TIMESTAMPTZ

        created_by : UUID <<FK, NULL>>

        * created_at : TIMESTAMPTZ
    }
}

' ============================================================
' 3. AI LEAD INTELLIGENCE
' ============================================================

package "3. AI Lead Intelligence" {

    entity "LEAD_QUALIFICATIONS" as lead_qualifications {

        * id : UUID <<PK>>
        --

        * lead_id : UUID <<FK>>

        * status : VARCHAR(30)

        intent : VARCHAR(100)
        confidence : NUMERIC(5,4)

        reason : TEXT

        model_provider : VARCHAR(100)
        model_name : VARCHAR(150)
        model_version : VARCHAR(100)

        input_snapshot : JSONB
        output_snapshot : JSONB

        * created_at : TIMESTAMPTZ
    }


    entity "LEAD_ENRICHMENTS" as lead_enrichments {

        * id : UUID <<PK>>
        --

        * lead_id : UUID <<FK>>

        * provider : VARCHAR(100)
        external_request_id : VARCHAR(255)

        * status : VARCHAR(30)

        company_name : VARCHAR(255)
        company_website : VARCHAR(500)
        company_industry : VARCHAR(150)
        company_size : INTEGER

        contact_job_title : VARCHAR(150)
        contact_linkedin_url : VARCHAR(500)

        raw_response : JSONB
        error_message : TEXT

        * enriched_at : TIMESTAMPTZ
        * created_at : TIMESTAMPTZ
    }


    entity "LEAD_SCORES" as lead_scores {

        * id : UUID <<PK>>
        --

        * lead_id : UUID <<FK>>

        * score : NUMERIC(5,2)
        * label : VARCHAR(30)

        reason : TEXT

        model_provider : VARCHAR(100)
        model_name : VARCHAR(150)
        model_version : VARCHAR(100)

        scoring_features : JSONB
        input_snapshot : JSONB
        output_snapshot : JSONB

        * created_at : TIMESTAMPTZ
    }
}

' ============================================================
' 4. FOLLOW-UP AUTOMATION
' ============================================================

package "4. Follow-up Automation" {

    entity "FOLLOW_UP_SEQUENCES" as follow_up_sequences {

        * id : UUID <<PK>>
        --

        * name : VARCHAR(150) <<UK>>
        description : TEXT

        * status : VARCHAR(30)

        * created_by : UUID <<FK>>
        updated_by : UUID <<FK, NULL>>

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }


    entity "FOLLOW_UP_STEPS" as follow_up_steps {

        * id : UUID <<PK>>
        --

        * sequence_id : UUID <<FK>>

        * step_order : INTEGER

        delay_minutes : INTEGER

        * channel : VARCHAR(50)
        * action_type : VARCHAR(50)

        subject_template : VARCHAR(255)
        content_template : TEXT

        conditions : JSONB
        metadata : JSONB

        * is_active : BOOLEAN

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }


    entity "LEAD_FOLLOW_UP_ENROLLMENTS" as follow_up_enrollments {

        * id : UUID <<PK>>
        --

        * lead_id : UUID <<FK>>
        * sequence_id : UUID <<FK>>

        current_step_id : UUID <<FK, NULL>>

        * status : VARCHAR(30)

        started_at : TIMESTAMPTZ
        paused_at : TIMESTAMPTZ
        completed_at : TIMESTAMPTZ
        cancelled_at : TIMESTAMPTZ

        assigned_by : UUID <<FK, NULL>>

        cancellation_reason : TEXT

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }


    entity "FOLLOW_UP_EXECUTIONS" as follow_up_executions {

        * id : UUID <<PK>>
        --

        * enrollment_id : UUID <<FK>>
        * step_id : UUID <<FK>>

        * status : VARCHAR(30)

        scheduled_at : TIMESTAMPTZ
        started_at : TIMESTAMPTZ
        completed_at : TIMESTAMPTZ

        provider_message_id : VARCHAR(255)

        request_payload : JSONB
        response_payload : JSONB

        error_message : TEXT
        retry_count : INTEGER

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }
}

' ============================================================
' 5. CUSTOMER MANAGEMENT
' ============================================================

package "5. Customer Management" {

    entity "CUSTOMERS" as customers {

        * id : UUID <<PK>>
        --

        * name : VARCHAR(200)
        * email : VARCHAR(320)
        phone : VARCHAR(30)

        company_name : VARCHAR(255)
        company_website : VARCHAR(500)
        job_title : VARCHAR(150)
        company_size : INTEGER
        industry : VARCHAR(150)

        status : VARCHAR(30)

        * created_by : UUID <<FK>>
        updated_by : UUID <<FK, NULL>>

        notes : TEXT

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }


    entity "SEGMENTS" as segments {

        * id : UUID <<PK>>
        --

        * name : VARCHAR(150) <<UK>>
        description : TEXT

        criteria : JSONB

        * is_active : BOOLEAN

        * created_by : UUID <<FK>>
        updated_by : UUID <<FK, NULL>>

        * created_at : TIMESTAMPTZ
        * updated_at : TIMESTAMPTZ
    }


    entity "CUSTOMER_SEGMENTS" as customer_segments {

        * customer_id : UUID <<PK, FK>>
        * segment_id : UUID <<PK, FK>>
        --

        * assignment_type : VARCHAR(30)
        confidence : NUMERIC(5,4)

        assigned_reason : TEXT

        * assigned_at : TIMESTAMPTZ

        assigned_by : UUID <<FK, NULL>>
    }
}

' ============================================================
' 6. WORKFLOW / HUMAN REVIEW / OBSERVABILITY
' ============================================================

package "6. Workflow & Governance" {

    entity "WORKFLOW_RUNS" as workflow_runs {

        * id : UUID <<PK>>
        --

        * workflow_name : VARCHAR(150)

        n8n_execution_id : VARCHAR(255) <<UK, NULL>>

        lead_id : UUID <<FK, NULL>>
        customer_id : UUID <<FK, NULL>>
        triggered_by_user_id : UUID <<FK, NULL>>

        * status : VARCHAR(30)

        input_payload : JSONB
        output_payload : JSONB

        error_message : TEXT

        started_at : TIMESTAMPTZ
        finished_at : TIMESTAMPTZ

        * created_at : TIMESTAMPTZ
    }


    entity "REVIEW_TASKS" as review_tasks {

        * id : UUID <<PK>>
        --

        * lead_id : UUID <<FK>>

        workflow_run_id : UUID <<FK, NULL>>

        assigned_to : UUID <<FK, NULL>>

        * status : VARCHAR(30)

        reason : TEXT

        decision : VARCHAR(30)
        review_comment : TEXT

        * created_at : TIMESTAMPTZ

        started_at : TIMESTAMPTZ
        resolved_at : TIMESTAMPTZ
    }


    entity "NOTIFICATIONS" as notifications {

        * id : UUID <<PK>>
        --

        * user_id : UUID <<FK>>

        * type : VARCHAR(50)

        * title : VARCHAR(255)
        content : TEXT

        lead_id : UUID <<FK, NULL>>
        customer_id : UUID <<FK, NULL>>
        review_task_id : UUID <<FK, NULL>>

        * is_read : BOOLEAN
        read_at : TIMESTAMPTZ

        * created_at : TIMESTAMPTZ
    }


    entity "AUDIT_LOGS" as audit_logs {

        * id : UUID <<PK>>
        --

        user_id : UUID <<FK, NULL>>

        * action : VARCHAR(100)

        * entity_type : VARCHAR(100)
        * entity_id : UUID

        old_value : JSONB
        new_value : JSONB

        metadata : JSONB

        ip_address : INET
        user_agent : TEXT

        * created_at : TIMESTAMPTZ
    }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' -------------------------
' USERS / LEADS / SOURCES
' -------------------------

users ||--o{ leads : "owns"

lead_sources ||--o{ leads : "source"

users |o--o{ interactions : "creates"

leads ||--o{ interactions : "has"

' -------------------------
' LEAD -> CUSTOMER CONVERSION
' -------------------------

customers ||--o{ leads : "converted_to"

users |o--o{ leads : "converted_by"

users |o--o{ customers : "creates"

users |o--o{ customers : "updates"

' -------------------------
' AI QUALIFICATION
' -------------------------

leads ||--o{ lead_qualifications : "has history"

' -------------------------
' AI ENRICHMENT
' -------------------------

leads ||--o{ lead_enrichments : "has history"

' -------------------------
' AI SCORING
' -------------------------

leads ||--o{ lead_scores : "has history"

' -------------------------
' FOLLOW-UP DEFINITION
' -------------------------

users ||--o{ follow_up_sequences : "creates"

users |o--o{ follow_up_sequences : "updates"

follow_up_sequences ||--o{ follow_up_steps : "contains"

' -------------------------
' FOLLOW-UP RUNTIME
' -------------------------

leads ||--o{ follow_up_enrollments : "enrolled"

follow_up_sequences ||--o{ follow_up_enrollments : "used by"

users |o--o{ follow_up_enrollments : "assigns"

follow_up_steps |o--o{ follow_up_enrollments : "current step"

follow_up_enrollments ||--o{ follow_up_executions : "produces"

follow_up_steps ||--o{ follow_up_executions : "executes"

' -------------------------
' CUSTOMER SEGMENTATION
' -------------------------

users ||--o{ segments : "creates"

users |o--o{ segments : "updates"

customers ||--o{ customer_segments : "belongs to"

segments ||--o{ customer_segments : "contains"

users |o--o{ customer_segments : "assigns"

' -------------------------
' WORKFLOW
' -------------------------

leads |o--o{ workflow_runs : "triggers"

customers |o--o{ workflow_runs : "triggers"

users |o--o{ workflow_runs : "triggered by"

' -------------------------
' HUMAN REVIEW
' -------------------------

leads ||--o{ review_tasks : "requires review"

workflow_runs |o--o{ review_tasks : "creates"

users |o--o{ review_tasks : "assigned to"

' -------------------------
' NOTIFICATIONS
' -------------------------

users ||--o{ notifications : "receives"

leads |o--o{ notifications : "about"

customers |o--o{ notifications : "about"

review_tasks |o--o{ notifications : "generates"

' -------------------------
' AUDIT
' -------------------------

users |o--o{ audit_logs : "performs"

' ============================================================
' CONSTRAINT / INDEX NOTES
' ============================================================

note right of users
CONSTRAINTS

UNIQUE(email)

INDEX:
- email
- role
- status

Security:
- password_hash only
- never store plaintext password
end note


note right of leads
CONSTRAINTS

FK:
- source_id
- owner_id
- converted_customer_id
- converted_by

INDEX:
- email
- status
- owner_id
- source_id
- created_at

BUSINESS:
A Lead can convert to
at most one Customer.
end note


note right of lead_qualifications
HISTORY TABLE

Never overwrite old AI results.

INDEX:
- lead_id
- created_at DESC

confidence:
0.0000 -> 1.0000

Store:
- provider
- model
- version
- input
- output
end note


note right of lead_enrichments
EXTERNAL DATA

Structured data:
- company_name
- industry
- company_size
- website
- contact_job_title

raw_response:
JSONB

INDEX:
- lead_id
- created_at DESC
end note


note right of lead_scores
SCORING HISTORY

score:
0.00 -> 100.00

label:
HOT / WARM / COLD

Never overwrite historical
scores.

INDEX:
- lead_id
- created_at DESC
end note


note right of interactions
BEHAVIORAL DATA

Examples:
- EMAIL
- CALL
- MEETING
- MESSAGE
- FORM_SUBMIT
- PAGE_VIEW

Used as input for
Lead Scoring.

INDEX:
- lead_id
- occurred_at DESC
end note


note right of follow_up_sequences
REUSABLE DEFINITION

Example:
"Hot Lead Sequence"

A sequence contains
ordered Follow-up Steps.
end note


note right of follow_up_steps
CONSTRAINT

UNIQUE(
    sequence_id,
    step_order
)

INDEX:
- sequence_id
- step_order

The step defines:
- delay
- channel
- action
- template
- conditions
end note


note right of follow_up_enrollments
RUNTIME ENROLLMENT

Connects:

Lead
  +
Sequence

Tracks current execution
state for a specific Lead.

Consider idempotency rule
to prevent duplicate enrollment.
end note


note right of follow_up_executions
RUNTIME EXECUTION HISTORY

Required for:
- retry
- failure
- monitoring
- audit
- idempotency

INDEX:
- enrollment_id
- step_id
- status
- scheduled_at

provider_message_id may be
UNIQUE when provider guarantees
uniqueness.
end note


note right of customers
CUSTOMER CREATED AFTER
LEAD CONVERSION

Important:
- created_by
- updated_by

INDEX:
- email
- status
- company_name
end note


note right of segments
SEGMENT DEFINITION

criteria = JSONB

Example:

{
  "score": { "gte": 80 },
  "industry": ["SaaS", "FinTech"]
}

The JSON stores the rule,
not the customer records.
end note


note right of customer_segments
M:N BRIDGE

PRIMARY KEY:
(customer_id, segment_id)

Additional data:
- assignment_type
- confidence
- assigned_reason
- assigned_at

Assignment can come from:
MANUAL
RULE
AI
end note


note right of workflow_runs
APPLICATION-LEVEL
WORKFLOW TRACKING

n8n keeps its own execution
details.

CRM stores:
- business context
- relation to Lead/Customer
- status
- input/output
- error
- execution reference
end note


note right of review_tasks
HUMAN-IN-THE-LOOP

Created when AI confidence
is low or business rules require
manual approval.

Lifecycle:

PENDING
  ↓
IN_REVIEW
  ↓
APPROVED / REJECTED / RESOLVED

Keeps:
- reason
- decision
- reviewer
- comment
- timestamps
end note


note right of notifications
USER NOTIFICATION

Examples:
- Lead requires review
- Lead score changed
- Follow-up failed
- Workflow failed

May reference:
Lead
Customer
ReviewTask
end note


note right of audit_logs
AUDIT TRAIL

For critical business operations:

- Lead status changes
- Lead assignment
- AI approval/rejection
- Lead conversion
- Segment assignment
- Follow-up changes

Polymorphic target:
entity_type + entity_id
end note


' ============================================================
' USE CASE TRACEABILITY
' ============================================================

note as TRACEABILITY
USE CASE -> MAIN DATA

UC01 Create Lead
  -> USERS
  -> LEAD_SOURCES
  -> LEADS

UC02 AI Qualification
  -> LEADS
  -> LEAD_QUALIFICATIONS
  -> WORKFLOW_RUNS

UC03 AI Enrichment
  -> LEADS
  -> LEAD_ENRICHMENTS
  -> WORKFLOW_RUNS

UC04 AI Lead Scoring
  -> LEADS
  -> LEAD_SCORES
  -> INTERACTIONS

UC05 Enroll Follow-up
  -> FOLLOW_UP_SEQUENCES
  -> FOLLOW_UP_STEPS
  -> LEAD_FOLLOW_UP_ENROLLMENTS

UC06 Execute Follow-up
  -> FOLLOW_UP_EXECUTIONS
  -> WORKFLOW_RUNS

UC07 Human Review
  -> REVIEW_TASKS
  -> NOTIFICATIONS
  -> AUDIT_LOGS

UC08 Convert Lead -> Customer
  -> LEADS
  -> CUSTOMERS
  -> AUDIT_LOGS

UC09 Customer Segmentation
  -> CUSTOMERS
  -> SEGMENTS
  -> CUSTOMER_SEGMENTS
end note

@enduml