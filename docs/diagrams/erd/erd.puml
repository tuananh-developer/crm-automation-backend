@startuml
title AI CRM Automation — Complete Target Database ERD
hide methods
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam entity {
  BackgroundColor White
  BorderColor #425466
}



package "Core CRM and Workflow Tables" {
  entity users <<TABLE>> {
    * id : uuid <<PK>>
    name : varchar
    email : varchar <<UK>>
    password_hash : varchar
    role : varchar
    status : varchar
    last_login_at : timestamptz?
    created_at : timestamptz
    updated_at : timestamptz
  }

  entity lead_sources <<TABLE>> {
    * id : uuid <<PK>>
    name : varchar <<UK>>
    description : text?
    is_active : boolean
    created_at : timestamptz
    updated_at : timestamptz
  }

  entity leads <<TABLE>> {
    * id : uuid <<PK>>
    first_name : varchar
    last_name : varchar?
    email : varchar
    phone : varchar?
    company_name : varchar?
    company_website : varchar?
    job_title : varchar?
    company_size : integer?
    industry : varchar?
    status : varchar
    source_id : uuid <<FK>>
    owner_id : uuid? <<FK>>
    converted_customer_id : uuid? <<FK>>
    converted_by : uuid? <<FK>>
    converted_at : timestamptz?
    notes : text?
    created_at : timestamptz
    updated_at : timestamptz
  }

  entity interactions <<TABLE>> {
    * id : uuid <<PK>>
    lead_id : uuid <<FK>>
    type : varchar
    channel : varchar?
    subject : varchar?
    content : text?
    metadata : jsonb?
    occurred_at : timestamptz
    created_by : uuid? <<FK>>
    created_at : timestamptz
  }

  entity lead_qualifications <<TABLE>> {
    * id : uuid <<PK>>
    lead_id : uuid <<FK>>
    status : varchar
    intent : varchar?
    confidence : numeric?
    reason : text?
    model_provider : varchar?
    model_name : varchar?
    model_version : varchar?
    input_snapshot : jsonb?
    output_snapshot : jsonb?
    created_at : timestamptz
    workflow_run_id : uuid? <<FK>>
  }

  entity lead_enrichments <<TABLE>> {
    * id : uuid <<PK>>
    lead_id : uuid <<FK>>
    workflow_run_id : uuid? <<FK>>
    provider : varchar
    external_request_id : varchar?
    status : varchar
    company_name : varchar?
    company_website : varchar?
    company_industry : varchar?
    company_size : integer?
    contact_job_title : varchar?
    contact_linkedin_url : varchar?
    raw_response : jsonb?
    error_message : text?
    enriched_at : timestamptz
    created_at : timestamptz
  }

  entity lead_scores <<TABLE>> {
    * id : uuid <<PK>>
    lead_id : uuid <<FK>>
    workflow_run_id : uuid? <<FK>>
    score : numeric
    label : varchar
    reason : text?
    model_provider : varchar?
    model_name : varchar?
    model_version : varchar?
    scoring_features : jsonb?
    input_snapshot : jsonb?
    output_snapshot : jsonb?
    created_at : timestamptz
  }

  entity follow_up_sequences <<TABLE>> {
    * id : uuid <<PK>>
    name : varchar <<UK>>
    description : text?
    status : varchar
    created_by : uuid <<FK>>
    updated_by : uuid? <<FK>>
    created_at : timestamptz
    updated_at : timestamptz
  }

  entity follow_up_steps <<TABLE>> {
    * id : uuid <<PK>>
    sequence_id : uuid <<FK>>
    step_order : integer
    delay_minutes : integer
    channel : varchar
    action_type : varchar
    subject_template : text?
    content_template : text?
    conditions : jsonb?
    metadata : jsonb?
    is_active : boolean
    created_at : timestamptz
    updated_at : timestamptz
  }

  entity lead_follow_up_enrollments <<TABLE>> {
    * id : uuid <<PK>>
    lead_id : uuid <<FK>>
    sequence_id : uuid <<FK>>
    current_step_id : uuid? <<FK>>
    status : varchar
    started_at : timestamptz?
    paused_at : timestamptz?
    completed_at : timestamptz?
    cancelled_at : timestamptz?
    assigned_by : uuid? <<FK>>
    cancellation_reason : text?
    created_at : timestamptz
    updated_at : timestamptz
  }

  entity follow_up_executions <<TABLE>> {
    * id : uuid <<PK>>
    enrollment_id : uuid <<FK>>
    step_id : uuid <<FK>>
    status : varchar
    scheduled_at : timestamptz?
    started_at : timestamptz?
    completed_at : timestamptz?
    provider_message_id : varchar?
    request_payload : jsonb?
    response_payload : jsonb?
    error_message : text?
    retry_count : integer
    created_at : timestamptz
    updated_at : timestamptz
  }

  entity customers <<TABLE>> {
    * id : uuid <<PK>>
    name : varchar
    email : varchar
    phone : varchar?
    company_name : varchar?
    company_website : varchar?
    job_title : varchar?
    company_size : integer?
    industry : varchar?
    status : varchar?
    created_by : uuid <<FK>>
    updated_by : uuid? <<FK>>
    notes : text?
    created_at : timestamptz
    updated_at : timestamptz
    is_strategic : boolean 
    strategic_marked_by : uuid? <<FK>>
  }

  entity segments <<TABLE>> {
    * id : uuid <<PK>>
    name : varchar <<UK>>
    description : text?
    criteria : jsonb?
    is_active : boolean
    created_by : uuid <<FK>>
    updated_by : uuid? <<FK>>
    created_at : timestamptz
    updated_at : timestamptz
  }

  entity customer_segments <<TABLE>> {
    customer_id : uuid <<PK, FK>>
    segment_id : uuid <<PK, FK>>
    assignment_type : varchar
    confidence : numeric?
    assigned_reason : text?
    assigned_at : timestamptz
    assigned_by : uuid? <<FK>>
  }

  entity workflow_runs <<TABLE>> {
    * id : uuid <<PK>>
    workflow_name : varchar
    n8n_execution_id : varchar? <<UK (unique index)>>
    lead_id : uuid? <<FK>>
    customer_id : uuid? <<FK>>
    triggered_by_user_id : uuid? <<FK>>
    status : varchar
    input_payload : jsonb?
    output_payload : jsonb?
    error_message : text?
    started_at : timestamptz?
    finished_at : timestamptz?
    created_at : timestamptz
  }

  entity review_tasks <<TABLE>> {
    * id : uuid <<PK>>
    lead_id : uuid? <<FK, nullable>>
    workflow_run_id : uuid? <<FK>>
    assigned_to : uuid? <<FK>>
    status : varchar
    reason : text?
    decision : varchar?
    review_comment : text?
    created_at : timestamptz
    started_at : timestamptz?
    resolved_at : timestamptz?
    target_entity_type : varchar? 
    target_entity_id : uuid? <<POLYMORPHIC, NO FK>>
  }

  entity notifications <<TABLE>> {
    * id : uuid <<PK>>
    user_id : uuid <<FK>>
    type : varchar
    title : varchar
    content : text?
    lead_id : uuid? <<FK>>
    customer_id : uuid? <<FK>>
    review_task_id : uuid? <<FK>>
    is_read : boolean
    read_at : timestamptz?
    created_at : timestamptz
  }

  entity audit_logs <<TABLE>> {
    * id : uuid <<PK>>
    user_id : uuid? <<FK>>
    action : varchar
    entity_type : varchar
    entity_id : uuid
    old_value : jsonb?
    new_value : jsonb?
    metadata : jsonb?
    ip_address : varchar?
    user_agent : text?
    created_at : timestamptz
  }

}

package "Customer Insights, Conversations, Quotes and Renewals" {
