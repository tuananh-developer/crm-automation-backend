@startuml
title AI CRM Automation — Complete Domain Model
 hide methods
 skinparam classAttributeIconSize 0
 skinparam linetype ortho
 skinparam shadowing false
 skinparam packageStyle rectangle



 package "Identity & Governance" {
   class User <<ENTITY>> {
     id: UUID
     name: string
     email: string
     role: UserRole
     status: UserStatus
   }
   class AuditLog <<ENTITY>> {
     id: UUID
     userId: UUID?
     action: string
     entityType: string
     entityId: UUID
   }
   class Notification <<ENTITY>> {
     id: UUID
     userId: UUID
     type: string
     title: string
     content: text?
     leadId: UUID?
     customerId: UUID?
     reviewTaskId: UUID?
     isRead: boolean
     readAt: timestamptz?
   }
   class ReviewTask <<ENTITY>> {
     id: UUID
     leadId: UUID? [nullable]
     workflowRunId: UUID?
     assignedTo: UUID?
     status: ReviewStatus
     decision: ReviewDecision?
     targetEntityType: string? [polymorphic target; no FK]
     targetEntityId: UUID? [polymorphic target; no FK]
   }
   class WorkflowRun <<ENTITY>> {
     id: UUID
     workflowName: string
     n8nExecutionId: string?
     leadId: UUID?
     customerId: UUID?
     triggeredByUserId: UUID?
     status: WorkflowStatus
     inputPayload: JSONB?
     outputPayload: JSONB?
     errorMessage: string?
   }
 }

 package "Lead & Intelligence" {
   class LeadSource <<ENTITY>> {
     id: UUID
     name: string
     isActive: boolean
   }
   class Lead <<ENTITY>> {
     id: UUID
     firstName: string
     lastName: string?
     email: string
     phone: string?
     status: LeadStatus
     sourceId: UUID
     ownerId: UUID?
     convertedCustomerId: UUID?
     convertedBy: UUID?
   }
   class Interaction <<ENTITY>> {
     id: UUID
     leadId: UUID
     type: string
     channel: string?
     content: text?
   }
   class LeadQualification <<ENTITY>> {
     id: UUID
     leadId: UUID
     workflowRunId: UUID?
     status: QualificationStatus
     confidence: decimal?
   }
   class LeadEnrichment <<ENTITY>> {
     id: UUID
     leadId: UUID
     workflowRunId: UUID?
     provider: string
     status: EnrichmentStatus
   }
   class LeadScore <<ENTITY>> {
     id: UUID
     leadId: UUID
     workflowRunId: UUID?
     score: decimal
     label: ScoreLabel
   }
 }

 package "Follow-up Automation" {
   class FollowUpSequence <<ENTITY>> {
     id: UUID
     name: string
     status: string
     createdBy: UUID
     updatedBy: UUID?
   }
   class FollowUpStep <<ENTITY>> {
     id: UUID
     sequenceId: UUID
     stepOrder: int
     delayMinutes: int
     channel: string
   }
   class LeadFollowUpEnrollment <<ENTITY>> {
     id: UUID
     leadId: UUID
     sequenceId: UUID
     currentStepId: UUID?
     status: string
     assignedBy: UUID?
   }
   class FollowUpExecution <<ENTITY>> {
     id: UUID
     enrollmentId: UUID
     stepId: UUID
     status: string
     retryCount: int
   }
 }

 package "Customer & Segmentation" {
   class Customer <<ENTITY>> {
     id: UUID
     name: string
     email: string
     status: string?
     createdBy: UUID
     updatedBy: UUID?
     isStrategic: boolean 
     strategicMarkedBy: UUID? 
   }
   class Segment <<ENTITY>> {
     id: UUID
     name: string
     criteria: JSONB?
     isActive: boolean
     createdBy: UUID
     updatedBy: UUID?
   }
   class CustomerSegment <<ENTITY>> {
     customerId: UUID
     segmentId: UUID
     assignmentType: string
   }
 }

 package "Customer Insights and Operational Tasks" {
   class CustomerIssue <<ENTITY>> {
     id: UUID
     customerId: UUID
     title: string
     severity: string
     status: string
     assignedTo: UUID?
     createdBy: UUID?
   }
   class CustomerChurnAssessment <<ENTITY>> {
     id: UUID
     customerId: UUID
     riskScore: decimal?
     riskLevel: string
     assessmentStatus: string
     assessedAt: timestamptz
   }
   class CustomerFeedback <<ENTITY>> {
     id: UUID
     customerId: UUID
     source: string
     rating: decimal?
     sentiment: string?
     category: string?
     urgency: string?
     status: string
     receivedAt: timestamptz
   }
   class CustomerHealthAssessment <<ENTITY>> {
     id: UUID
     customerId: UUID
     healthScore: decimal?
     healthStatus: string
     dataCoverage: decimal?
     policyVersion: string
   }
   class CustomerTask <<ENTITY>> {
     id: UUID
     customerId: UUID
     taskType: string
     title: string
     description: text?
     priority: string
     status: string
     assignedTo: UUID?
     createdBy: UUID?
     dueAt: timestamptz?
     idempotencyKey: string [unique]
   }
 }

 package "Conversations and Sales Meetings" {
   class SalesMeeting <<ENTITY>> {
     id: UUID
     customerId: UUID?
     leadId: UUID?
     organizerUserId: UUID?
     title: string
     scheduledAt: timestamptz?
     status: string
   }
   class ConversationTranscript <<ENTITY>> {
     id: UUID
     meetingId: UUID?
     customerId: UUID?
     leadId: UUID?
     sourceType: string
     redactedContent: text
     processingStatus: string
     createdBy: UUID?
   }
   class ConversationSummary <<ENTITY>> {
     id: UUID
     transcriptId: UUID
     summaryText: text
     sentiment: string?
     keyPoints: JSONB?
   }
   class ConversationActionItem <<ENTITY>> {
     id: UUID
     summaryId: UUID
     title: string
     assignedTo: UUID?
     dueAt: timestamptz?
     status: string
     approvalState: string
   }
 }

 package "Quotes and Renewals" {
   class ProductCatalogItem <<ENTITY>> {
     id: UUID
     sku: string
     name: string
     listPrice: decimal
     currency: string
   }
   class Quote <<ENTITY>> {
     id: UUID
     customerId: UUID?
     leadId: UUID?
     status: string
     currency: string
     totalAmount: decimal
     approvedBy: UUID?
   }
   class QuoteItem <<ENTITY>> {
     id: UUID
     quoteId: UUID
     catalogItemId: UUID?
     quantity: decimal
     unitPriceSnapshot: decimal
     lineTotal: decimal
   }
   class CustomerContract <<ENTITY>> {
     id: UUID
     customerId: UUID
     contractNumber: string
     status: string
     renewalDate: date
   }
   class RenewalAttempt <<ENTITY>> {
     id: UUID
     contractId: UUID
     status: string
     channel: string
     scheduledAt: timestamptz?
   }
 }

