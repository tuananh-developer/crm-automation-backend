# Application Mode
PORT=3000
NODE_ENV=development

# Environment Mode Toggles (Local Docker vs Remote Cloud)
USE_CLOUD_AMQP=false
USE_LOCAL_DB=false

# 1. Database Configuration
# Remote Neon Cloud PostgreSQL (used when USE_LOCAL_DB=false):
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=crm_backend
DB_SSL=false

# Local Docker Database (used when USE_LOCAL_DB=true):
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=crm_backend

# 2. RabbitMQ Configuration
# Remote CloudAMQP (used when USE_CLOUD_AMQP=true or NODE_ENV=production):
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_URL=
RABBITMQ_QUEUE=crm_events_queue

# Local Docker RabbitMQ (used when USE_CLOUD_AMQP=false and NODE_ENV=development):
LOCAL_RABBITMQ_HOST=localhost
LOCAL_RABBITMQ_PORT=5672
LOCAL_RABBITMQ_USER=
LOCAL_RABBITMQ_PASSWORD=

# 3. Authentication & Security
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=86400
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# 4. n8n Automation & Webhooks
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_FOLLOW_UP_WEBHOOK_PATH=follow-up-execute
N8N_WEBHOOK_TIMEOUT_MS=15000

FOLLOW_UP_MAX_RETRIES=3
FOLLOW_UP_RETRY_DELAY_MINUTES=10

# 5. URLs & CORS
FRONTEND_URL=http://localhost:3001
BACKEND_INTERNAL_URL=http://host.docker.internal:3000

# 6. AI Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro