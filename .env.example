# Application
PORT=3000
NODE_ENV=development

# Environment Mode Toggles (Local Docker vs Remote Cloud)
USE_CLOUD_AMQP=false
USE_LOCAL_DB=false

# Database CRM (Kết nối vào PostgreSQL cho NestJS CRM)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=crm_backend

# RabbitMQ 
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

RABBITMQ_URL=
RABBITMQ_QUEUE=crm_events_queue

# n8n Automation Webhook & Authentication
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_API_KEY=

# Đường dẫn Webhook của workflow UC06 - Execute Follow-up
N8N_FOLLOW_UP_WEBHOOK_PATH=follow-up-execute
# Timeout gọi Webhook n8n (ms) - hết thời gian sẽ được retry
N8N_WEBHOOK_TIMEOUT_MS=15000

# UC06 - Execute Follow-up: số lần retry tối đa cho 1 step (tổng cộng 1 + MAX lần gửi)
FOLLOW_UP_MAX_RETRIES=3
# Thời gian chờ (phút) giữa 2 lần retry
FOLLOW_UP_RETRY_DELAY_MINUTES=10

# Frontend Client URL (cho CORS)
FRONTEND_URL=http://localhost:3001

# Google Gemini AI & LLM Engine (dùng cho n8n UC02 AI Lead Qualification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Internal Backend URL (n8n container gọi về Backend NestJS)
BACKEND_INTERNAL_URL=http://host.docker.internal:3000

# Authentication & Security (JWT)
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=86400